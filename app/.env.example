# ===== 应用 =====
APP_NAME=天格
API_PREFIX=/api/v1
ENV=dev
DEBUG=true

# ===== 数据库（SQLite 本地；生产可改 MySQL/PostgreSQL）=====
DATABASE_URL=sqlite:///./tiange.db

# ===== 安全 =====
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=10080
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== 验证码 / 邮箱（本地 dev 可用打印代替真实邮件）=====
EMAIL_MOCK=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ===== 注册赠送 =====
REGISTER_BONUS_BEANS=50
INVITE_BONUS_BEANS=20

# ===== AI（真实 LLM，OpenAI 兼容；不配置则 AI 类接口返回提示错误）=====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== CORS =====
CORS_ORIGINS=*
